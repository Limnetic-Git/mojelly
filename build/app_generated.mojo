def __mojelly_dto_dto_validation_test(req: HTTPRequest) -> HTTPResponse:
    var dto_opt = try_deserialize[UserDTO](req.body)
    if not dto_opt:
        return HTTPResponse(400, "Invalid JSON body")
    var dto = dto_opt.take()
    return dto_validation_test(req, dto^)


